# --- Binance USDT-M Futures ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Trading ---
SYMBOL=XAU/USDT:USDT
LEVERAGE=3
MARGIN_MODE=isolated
SIGNAL_TIMEFRAME=5m
TREND_TIMEFRAME=1h
DEFAULT_STRATEGY=balanced

# --- Risk ---
RISK_PCT=0.005            # 0.5% per trade
DAILY_MAX_LOSS_PCT=0.03   # 3% of starting equity per UTC day
MAX_TRADES_PER_DAY=8
COOLDOWN_SECONDS_AFTER_SL=600

# --- Safety ---
LIVE_ENABLED=false        # Must be true to place real orders (testnet runs regardless)

# --- API / Auth ---
API_BEARER_TOKEN=change-me-please
CORS_ORIGINS=http://localhost:3100

# --- Storage ---
# Local development: SQLite
# DATABASE_URL=sqlite:///./xau_bot.db
# Production / Railway: PostgreSQL (Railway auto-injects this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xau_bot
LOG_RETENTION=2000        # ring-buffer size for live log feed
